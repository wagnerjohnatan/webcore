# Copie este arquivo para .env.local APENAS para testes locais.
# Nunca envie .env.local para o GitHub.

# Client ID OAuth 2.0 do tipo "Aplicativo da Web".
GOOGLE_CLIENT_ID=000000000000-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com

# PRIMEIRO DEPLOY:
# Informe somente seu e-mail Google verificado para descobrir seu SUB pelo painel.
ADMIN_EMAIL=seu-email@gmail.com

# DEPOIS DO PRIMEIRO LOGIN:
# Copie o SUB exibido no painel Admin, preencha abaixo e faça novo deploy.
ADMIN_GOOGLE_SUB=

# Chave da Gemini API. Mantenha como Secret no Vercel.
GEMINI_API_KEY=

# Modelo utilizado pela manutenção inteligente.
GEMINI_MODEL=gemini-3.8-flash

# false = sem pesquisa web; true = usa Google Search Grounding (pode ter cobrança própria).
GEMINI_USE_GOOGLE_SEARCH=false

# Opcional. URL que será transformada em QR Code de doação.
DONATION_URL=
